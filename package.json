{
  "name": "showrunner-os",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/all.test.ts",
    "check": "bash scripts/secret-scan.sh",
    "build": "rm -rf dist dist-server && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/server.mjs",
    "start": "node --expose-gc dist-server/server.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server"
  },
  "dependencies": {
    "@google/genai": "1.19.0",
    "@tailwindcss/vite": "4.1.11",
    "@vitejs/plugin-react": "4.6.0",
    "dotenv": "17.2.3",
    "express": "4.21.2",
    "jszip": "3.10.1",
    "lucide-react": "0.546.0",
    "motion": "12.23.24",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "vite": "6.3.5",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.14.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@types/ws": "8.18.1",
    "autoprefixer": "10.4.21",
    "esbuild": "0.25.0",
    "tailwindcss": "4.1.11",
    "tsx": "4.21.0",
    "typescript": "5.8.3"
  }
}
