# ShowRunner OS v1.3.0 Runtime Configuration
# SHOWRUNNER_MODE: "termux" (binds 127.0.0.1:5000, requires bearer token) or "preview" (binds 0.0.0.0:3000)
SHOWRUNNER_MODE="termux"

# SHOWRUNNER_PORT: Port to bind (default 5000 in termux mode, 3000 in preview mode)
SHOWRUNNER_PORT="5000"

# NODE_ENV: "production" or "development"
NODE_ENV="production"

# SHOWRUNNER_TOKEN_PATH: Optional custom path to the local 0600 bearer token file (defaults to ~/.showrunner_token)
SHOWRUNNER_TOKEN_PATH=""

# GEMINI_API_KEY: Optional preview-only seed key (in Termux mode, add keys via Stage 0 AES-256-GCM Vault UI)
GEMINI_API_KEY=""
